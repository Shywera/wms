# Kopiraj u `.env` i prilagodi po potrebi.

# Baza (zadano: lokalni SQLite wms.db). Za Postgres:
# DATABASE_URL=postgresql+psycopg2://user:pass@host/wms

# Tajni ključ za potpisivanje session cookieja — OBAVEZNO promijeni (npr. `python -c "import secrets;print(secrets.token_hex(32))"`).
SECRET_KEY=promijeni-me-na-dugacak-nasumicni-niz

# Lozinka početnog admina (kreira se samo pri praznoj bazi; korisnik: admin).
ADMIN_PASSWORD=admin

# ERP adapter za dohvat artikla po barkodu: mock | erp  (zadano: mock)
ERP_ADAPTER=mock

# Spoj na legacy ERP (samo kad je ERP_ADAPTER=erp) — ERP je READ-ONLY.
# ERP_API_URL=https://erp.interno
# ERP_API_USER=
# ERP_API_PASS=
